{
  "$id": "https://astra-spec.org/v1/analysis.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A self-similar analysis specification.\n\nEvery level has the same structure: metadata, inputs, outputs,\ndecisions, insights, and optional sub-analyses. A sub-analysis extracted\nto its own file is a valid Analysis on its own.\n\nAt the root level, ``version``, ``name``, ``inputs``, and\n``outputs`` are required. In sub-analyses they are optional.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSON Schema reference",
      "title": "$Schema"
    },
    "version": {
      "anyOf": [
        {
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "ASTRA specification version",
      "title": "Version"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable name for the analysis",
      "title": "Name"
    },
    "authors": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "List of authors",
      "title": "Authors"
    },
    "tags": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tags for categorization",
      "title": "Tags"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detailed description of this analysis",
      "title": "Description"
    },
    "success_criteria": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SuccessCriterion"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Concrete criteria for determining if this analysis succeeded. Each criterion is a structured object with a claim and optional output reference.",
      "title": "Success Criteria"
    },
    "inputs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "List of inputs for this analysis",
      "title": "Inputs"
    },
    "outputs": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "List of expected outputs from this analysis",
      "title": "Outputs"
    },
    "decisions": {
      "additionalProperties": {
        "$ref": "#/$defs/Decision"
      },
      "description": "Map of decision IDs to decision specifications",
      "title": "Decisions",
      "type": "object"
    },
    "insights": {
      "additionalProperties": {
        "$ref": "#/$defs/Insight"
      },
      "description": "Map of insight IDs to insight specifications",
      "title": "Insights",
      "type": "object"
    },
    "container": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/ContainerBuildSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default container image for recipes in this node. Can be a string (pre-built image) or a build spec with 'build' key.",
      "title": "Container"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path to a directory containing its own astra.yaml. When set, the sub-analysis content is loaded from <path>/astra.yaml. Mutually exclusive with inline content fields (inputs, outputs, decisions, etc.).",
      "title": "Path"
    },
    "analyses": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/Analysis"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Map of sub-analysis IDs to nested analyses",
      "title": "Analyses"
    }
  },
  "title": "ASTRA Analysis Specification",
  "type": "object",
  "$defs": {
    "Analysis": {
      "$id": "https://astra-spec.org/v1/analysis.schema.json",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "description": "A self-similar analysis specification.\n\nEvery level has the same structure: metadata, inputs, outputs,\ndecisions, insights, and optional sub-analyses. A sub-analysis extracted\nto its own file is a valid Analysis on its own.\n\nAt the root level, ``version``, ``name``, ``inputs``, and\n``outputs`` are required. In sub-analyses they are optional.",
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "JSON Schema reference",
          "title": "$Schema"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ASTRA specification version",
          "title": "Version"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable name for the analysis",
          "title": "Name"
        },
        "authors": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of authors",
          "title": "Authors"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags for categorization",
          "title": "Tags"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed description of this analysis",
          "title": "Description"
        },
        "success_criteria": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SuccessCriterion"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete criteria for determining if this analysis succeeded. Each criterion is a structured object with a claim and optional output reference.",
          "title": "Success Criteria"
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Input"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of inputs for this analysis",
          "title": "Inputs"
        },
        "outputs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Output"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of expected outputs from this analysis",
          "title": "Outputs"
        },
        "decisions": {
          "additionalProperties": {
            "$ref": "#/$defs/Decision"
          },
          "description": "Map of decision IDs to decision specifications",
          "title": "Decisions",
          "type": "object"
        },
        "insights": {
          "additionalProperties": {
            "$ref": "#/$defs/Insight"
          },
          "description": "Map of insight IDs to insight specifications",
          "title": "Insights",
          "type": "object"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ContainerBuildSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default container image for recipes in this node. Can be a string (pre-built image) or a build spec with 'build' key.",
          "title": "Container"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to a directory containing its own astra.yaml. When set, the sub-analysis content is loaded from <path>/astra.yaml. Mutually exclusive with inline content fields (inputs, outputs, decisions, etc.).",
          "title": "Path"
        },
        "analyses": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Analysis"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Map of sub-analysis IDs to nested analyses",
          "title": "Analyses"
        }
      },
      "title": "ASTRA Analysis Specification",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "description": "Checksum for data integrity verification.",
      "properties": {
        "algorithm": {
          "description": "Hash algorithm",
          "enum": [
            "sha256",
            "sha512",
            "md5"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "description": "Hash value",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "ContainerBuildSpec": {
      "additionalProperties": false,
      "description": "Specification for building a container image from a Containerfile.",
      "properties": {
        "build": {
          "description": "Path to Containerfile relative to project root",
          "title": "Build",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Build context directory",
          "title": "Context"
        },
        "args": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Docker build arguments",
          "title": "Args"
        }
      },
      "required": [
        "build"
      ],
      "title": "ContainerBuildSpec",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A decision point in the analysis.\n\nA decision can be either locally defined (with ``label``, ``options``, etc.)\nor a reference to a parent decision via ``from``. When ``from`` is set, the\ndecision is a pure reference and must not have ``label``, ``options``, etc.\n\nThe ``from`` field uses ``../`` prefix syntax to reference parent scope:\n``from: ../z_min`` references the parent analysis's ``z_min`` decision.",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to a parent decision using '../' prefix (e.g., '../z_min'). When set, this decision is a pure reference.",
          "title": "From"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable name for the decision",
          "title": "Label"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this decision exists",
          "title": "Rationale"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags for grouping and categorizing this decision",
          "title": "Tags"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default option ID for baseline universes",
          "title": "Default"
        },
        "options": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/Option"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Map of option IDs to option specifications",
          "title": "Options"
        }
      },
      "title": "Decision",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Evidence from a source with W3C-compliant selectors.\n\nEvidence can reference two kinds of sources:\n\n- **Literature** (``doi``): A paper referenced by DOI, with W3C selectors\n  pointing into the PDF. For arXiv papers, use DOI format\n  ``10.48550/arXiv.{id}`` and set ``version``.\n\n- **Analysis artifact** (``artifact``): An output produced by this\n  analysis, referenced by its output ID (the ``id`` field in\n  ``outputs``). The optional ``checksum`` ensures artifact integrity.\n\nExactly one of ``doi`` or ``artifact`` must be set.\nAt least one content selector (quote, figure, or table) is required.",
      "oneOf": [
        {
          "properties": {
            "doi": {
              "type": "string"
            }
          },
          "required": [
            "doi"
          ]
        },
        {
          "properties": {
            "artifact": {
              "type": "string"
            }
          },
          "required": [
            "artifact"
          ]
        }
      ],
      "properties": {
        "id": {
          "description": "Evidence ID",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "pattern": "^10\\.\\d{4,}/.*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DOI of the source paper (e.g., '10.48550/arXiv.1706.03762')",
          "title": "Doi"
        },
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output ID referencing a declared output in this analysis",
          "title": "Artifact"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Paper version for arXiv papers (version matters for reproducibility)",
          "title": "Version"
        },
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checksum"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Checksum of the artifact for integrity verification"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to immutable copy of the artifact (only valid when artifact is set)",
          "title": "Snapshot"
        },
        "source_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Git commit that produced the original artifact (only valid when artifact is set)",
          "title": "Source Commit"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextQuoteSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text quote anchor"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Figure reference"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Table reference"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FragmentSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Location hint (page number for PDFs/reports)"
        }
      },
      "required": [
        "id"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FigureSelector": {
      "additionalProperties": false,
      "description": "Selector for referencing figures in scientific papers.\n\nExtension of W3C selector pattern for scientific literature.\nThe label is the authoritative identifier (e.g., \"Figure 3a\").",
      "properties": {
        "type": {
          "const": "FigureSelector",
          "default": "FigureSelector",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "description": "Figure label (e.g., 'Figure 3a', 'Fig. 1')",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption text for verification",
          "title": "Caption"
        }
      },
      "required": [
        "label"
      ],
      "title": "FigureSelector",
      "type": "object"
    },
    "FragmentSelector": {
      "additionalProperties": false,
      "description": "W3C FragmentSelector for PDF locations.\n\nSee: https://www.w3.org/TR/annotation-model/#fragment-selector\nConforms to RFC 3778/8118 for PDF fragments.",
      "properties": {
        "type": {
          "const": "FragmentSelector",
          "default": "FragmentSelector",
          "title": "Type",
          "type": "string"
        },
        "conformsTo": {
          "const": "http://tools.ietf.org/rfc/rfc3778",
          "default": "http://tools.ietf.org/rfc/rfc3778",
          "title": "Conformsto",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment (e.g., 'page=6')",
          "title": "Value"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-indexed page number",
          "title": "Page"
        }
      },
      "title": "FragmentSelector",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "description": "An input to the analysis.\n\nTwo kinds of inputs:\n- ``type: data`` \u2014 a dataset, file, or external resource (specify ``source``)\n- ``type: analysis`` \u2014 outputs from another ASTRA analysis (specify ``ref``)\n\nSub-analysis inputs can also use ``from`` to reference a parent input\nor a sibling's output (e.g., ``from: sibling_id.output_id``).",
      "properties": {
        "id": {
          "description": "Unique identifier for the input",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Type of input",
          "enum": [
            "data",
            "analysis"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the input",
          "title": "Description"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URI or path to the data source",
          "title": "Source"
        },
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checksum"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Checksum for data integrity verification"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to another ASTRA analysis",
          "title": "Ref"
        },
        "ref_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the referenced analysis",
          "title": "Ref Version"
        },
        "use_outputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific outputs to use from referenced analysis",
          "title": "Use Outputs"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to parent input or sibling output (e.g., 'input_id' or 'sibling.output_id')",
          "title": "From"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Input",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "description": "A scientific insight with provenance and supporting evidence.\n\nRepresents a discrete unit of scientific knowledge with full\ntraceability to source material. Evidence can come from literature\n(papers referenced by DOI) or from analysis artifacts (outputs\nreferenced by ID), both using W3C-compliant selectors.",
      "properties": {
        "id": {
          "description": "Unique identifier",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "description": "What we learned (1-2 sentences)",
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "created_at": {
          "description": "Creation timestamp (ISO 8601)",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "description": "Supporting evidence",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "derived": {
          "default": false,
          "description": "True if synthesized/inferred",
          "title": "Derived",
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Applicability conditions",
          "title": "Scope"
        },
        "tags": {
          "description": "Categorization tags",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reasoning notes",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "claim",
        "created_at",
        "evidence"
      ],
      "title": "Insight",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "description": "An option for a decision.",
      "properties": {
        "label": {
          "description": "Human-readable name for the option",
          "title": "Label",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed description of the option",
          "title": "Description"
        },
        "insights": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of insight IDs supporting this option",
          "title": "Insights"
        },
        "incompatible_with": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of decision.option pairs that cannot be selected together",
          "title": "Incompatible With"
        },
        "requires": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of decision.option pairs that must also be selected",
          "title": "Requires"
        },
        "excluded": {
          "default": false,
          "description": "Whether this option was considered and rejected",
          "title": "Excluded",
          "type": "boolean"
        },
        "excluded_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this option was excluded",
          "title": "Excluded Reason"
        }
      },
      "required": [
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "An expected output from the analysis.\n\nOutputs can declare their provenance via ``from`` to trace which\nsub-analysis produces them (e.g., ``from: inference.posterior``).",
      "properties": {
        "id": {
          "description": "Unique identifier for the output",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Type of output",
          "enum": [
            "metric",
            "figure",
            "table",
            "data",
            "report"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the output",
          "title": "Description"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sub-analysis output that produces this (e.g., 'sub_analysis.output_id')",
          "title": "From"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipe"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inline recipe describing how to produce this output"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Output",
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "description": "A build rule that produces an output.\n\nRecipes are the execution contract: run this command (optionally in a\ncontainer) to produce the parent output. Dependencies on other outputs\nare declared via ``inputs``.",
      "properties": {
        "command": {
          "description": "Command to execute (e.g., 'python src/train.py')",
          "title": "Command",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output IDs that must be materialized before this recipe runs",
          "title": "Inputs"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ContainerBuildSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Container image override (defaults to node-level container). Can be a string (pre-built image) or a build spec with 'build' key.",
          "title": "Container"
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resources"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Compute resource requirements"
        }
      },
      "required": [
        "command"
      ],
      "title": "Recipe",
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "description": "Compute resource requirements for a recipe.",
      "properties": {
        "cpus": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of CPUs",
          "title": "Cpus"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Memory requirement (e.g., '8GB', '512MB')",
          "title": "Memory"
        },
        "gpus": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of GPUs",
          "title": "Gpus"
        },
        "time_limit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum wall time (e.g., '2h', '30m')",
          "title": "Time Limit"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "SuccessCriterion": {
      "additionalProperties": false,
      "description": "A structured criterion linking a claim to an output and condition.",
      "properties": {
        "claim": {
          "description": "Human-readable statement of the criterion",
          "title": "Claim",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the output to check against",
          "title": "Output"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Condition to evaluate, e.g. 'value > 0.95'",
          "title": "Condition"
        }
      },
      "required": [
        "claim"
      ],
      "title": "SuccessCriterion",
      "type": "object"
    },
    "TableSelector": {
      "additionalProperties": false,
      "description": "Selector for referencing tables in scientific papers.\n\nExtension of W3C selector pattern for scientific literature.\nThe label is the authoritative identifier (e.g., \"Table 2\").",
      "properties": {
        "type": {
          "const": "TableSelector",
          "default": "TableSelector",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "description": "Table label (e.g., 'Table 1', 'Tab. 2')",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption/header text for verification",
          "title": "Caption"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific region (e.g., 'row 3')",
          "title": "Region"
        }
      },
      "required": [
        "label"
      ],
      "title": "TableSelector",
      "type": "object"
    },
    "TextQuoteSelector": {
      "additionalProperties": false,
      "description": "W3C TextQuoteSelector for locating text in a document.\n\nSee: https://www.w3.org/TR/annotation-model/#text-quote-selector\n\nThe authoritative anchor for verification. Text should be normalized\n(HTML/XML tags removed, entities decoded).",
      "properties": {
        "type": {
          "const": "TextQuoteSelector",
          "default": "TextQuoteSelector",
          "title": "Type",
          "type": "string"
        },
        "exact": {
          "description": "Exact quoted text (1-3 sentences)",
          "minLength": 1,
          "title": "Exact",
          "type": "string"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "~20-100 chars before for disambiguation",
          "title": "Prefix"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "~20-100 chars after for disambiguation",
          "title": "Suffix"
        }
      },
      "required": [
        "exact"
      ],
      "title": "TextQuoteSelector",
      "type": "object"
    }
  }
}
