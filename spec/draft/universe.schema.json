{
  "$defs": {
    "UniverseNode": {
      "additionalProperties": false,
      "description": "A universe node mirroring the analysis tree structure.",
      "properties": {
        "decisions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map of decision ID to selected option ID",
          "title": "Decisions",
          "type": "object"
        },
        "analyses": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/UniverseNode"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Map of sub-analysis IDs to their universe selections",
          "title": "Analyses"
        }
      },
      "title": "UniverseNode",
      "type": "object"
    }
  },
  "$id": "https://astra-spec.org/v1/universe.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "A universe specification - a complete set of decisions across the analysis tree.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSON Schema reference",
      "title": "$Schema"
    },
    "id": {
      "description": "Unique identifier for the universe",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What this universe represents",
      "title": "Description"
    },
    "decisions": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of decision ID to selected option ID (root-level decisions)",
      "title": "Decisions",
      "type": "object"
    },
    "analyses": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/UniverseNode"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Map of sub-analysis IDs to their universe selections",
      "title": "Analyses"
    }
  },
  "required": [
    "id"
  ],
  "title": "ASTRA Universe Specification",
  "type": "object"
}
