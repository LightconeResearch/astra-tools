        "Evidence": {
            "additionalProperties": false,
            "description": "Evidence source with content selectors",
            "properties": {
                "artifact": {
                    "description": "Output ID for artifact evidence",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "checksum": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Checksum"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "doi": {
                    "description": "DOI for literature evidence",
                    "pattern": "^10\\.\\d{4,}/.*$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "figure": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/FigureSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "id": {
                    "type": "string"
                },
                "location": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/LocationSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "quote": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/QuoteSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "snapshot": {
                    "description": "Path to immutable artifact copy",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source_commit": {
                    "description": "Git commit that produced the artifact",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "table": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TableSelector"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "version": {
                    "description": "Version number (e.g. arXiv version)",
                    "minimum": 1,
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "id"
            ],
            "title": "Evidence",
            "type": "object"
        },
        "FigureSelector": {
            "additionalProperties": false,
            "description": "Reference to a figure in a document",
            "properties": {
                "caption": {
                    "type": [
                        "string",
                        "null"
