                "label": {
                    "description": "Figure label (e.g. Figure 3a)",
                    "type": "string"
                }
            },
            "required": [
                "label"
            ],
            "title": "FigureSelector",
            "type": "object"
        },
        "Input": {
            "additionalProperties": false,
            "description": "An input to the analysis (data source or analysis reference)",
            "properties": {
                "based_on": {
                    "description": "Reference to another analysis",
