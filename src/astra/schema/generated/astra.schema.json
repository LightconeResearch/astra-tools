                "page": {
                    "description": "1-indexed page number",
                    "minimum": 1,
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "title": "LocationSelector",
            "type": "object"
        },
        "Option": {
            "additionalProperties": false,
            "description": "One selectable choice within a decision",
            "properties": {
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "excluded_reason": {
                    "description": "Why this option was excluded",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "incompatible_with": {
                    "description": "decision.option pairs that conflict",
                    "items": {
                        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "insights": {
                    "description": "Insight IDs that support this option",
                    "items": {
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "is_excluded": {
                    "description": "Whether this option was considered and rejected",
                    "type": [
                        "boolean",
                        "null"
                    ]
                },
                "label": {
                    "description": "Human-readable label",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                },
                "requires": {
                    "description": "decision.option pairs that must coexist",
                    "items": {
                        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                        "type": "string"
