                    "description": "Parent input or sibling output reference",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "label": {
                    "description": "Human-readable label",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                },
                "ref_version": {
                    "description": "Version of the referenced analysis",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "source": {
                    "description": "Path or URI for data inputs",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "type": {
                    "$ref": "#/$defs/InputTypeEnum"
                },
                "use_outputs": {
                    "description": "Specific output IDs from the referenced analysis",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "type",
                "name"
            ],
            "title": "Input",
            "type": "object"
        },
        "InputTypeEnum": {
            "description": "",
            "enum": [
                "data",
                "analysis"
            ],
            "title": "InputTypeEnum",
            "type": "string"
        },
        "Insight": {
            "additionalProperties": false,
            "description": "Scientific claim backed by evidence",
            "properties": {
                "claim": {
                    "description": "The claim text (1-2 sentences)",
                    "type": "string"
                },
                "created_at": {
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
