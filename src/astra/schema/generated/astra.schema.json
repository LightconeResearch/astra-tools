        "Checksum": {
            "additionalProperties": false,
            "description": "Data integrity checksum",
            "properties": {
                "algorithm": {
                    "$ref": "#/$defs/ChecksumAlgorithm"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "algorithm",
                "value"
            ],
            "title": "Checksum",
            "type": "object"
        },
        "ChecksumAlgorithm": {
            "description": "",
            "enum": [
                "sha256",
                "sha512",
                "md5"
            ],
            "title": "ChecksumAlgorithm",
            "type": "string"
        },
        "Decision": {
            "additionalProperties": false,
            "description": "A choice point with multiple options",
            "if": {
                "properties": {
                    "delegates_to": {}
                },
                "required": [
                    "delegates_to"
                ]
            },
            "properties": {
                "active_when": {
                    "description": "Conditions for this decision to be active",
                    "items": {
                        "pattern": "^~?[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "default": {
                    "description": "ID of the default option",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "delegates_to": {
                    "description": "Parent decision reference (e.g. ../random_seed)",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "label": {
                    "description": "Human-readable label",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                },
                "options": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Option__identifier_optional"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "rationale": {
                    "description": "Why this decision exists (alias for description)",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "tags": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "required": [
                "name"
            ],
            "then": {
                "not": {
                    "required": [
                        "options",
                        "default"
                    ]
                },
                "properties": {
                    "default": {},
                    "options": {}
                }
            },
            "title": "Decision",
            "type": "object"
        },
