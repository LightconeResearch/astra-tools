{
    "$defs": {
        "Analysis": {
            "additionalProperties": false,
            "description": "Root entity of an ASTRA analysis. Self-similar: can contain sub-analyses with the same structure.",
            "properties": {
                "analyses": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Analysis__identifier_optional"
                            },
                            {
                                "description": "ASTRA specification version",
                                "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
                                "type": "string"
                            }
                        ]
                    },
                    "description": "Sub-analyses (self-similar nesting)",
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "astra_version": {
                    "description": "ASTRA specification version",
                    "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
                    "type": "string"
                },
                "authors": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "container": {
                    "description": "Default container image for recipes",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "decisions": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Decision__identifier_optional"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "findings": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Insight__identifier_optional"
                    },
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "inputs": {
                    "items": {
                        "$ref": "#/$defs/Input"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "label": {
                    "description": "Human-readable label",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                },
                "outputs": {
                    "items": {
                        "$ref": "#/$defs/Output"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "prior_insights": {
                    "additionalProperties": {
                        "$ref": "#/$defs/Insight__identifier_optional"
                    },
                    "type": [
                        "object",
                        "null"
                    ]
                },
                "success_criteria": {
                    "items": {
                        "$ref": "#/$defs/SuccessCriterion"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "tags": {
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "universes": {
                    "additionalProperties": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/Universe__identifier_optional"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "type": [
                        "object",
                        "null"
                    ]
                }
            },
            "required": [
                "astra_version",
                "name"
            ],
            "title": "Analysis",
            "type": "object"
        },
