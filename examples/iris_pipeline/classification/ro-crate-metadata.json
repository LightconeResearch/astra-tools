        },
        {
            "@id": "https://w3id.org/astra/profile/1.0",
            "@type": [
                "CreativeWork",
                "Profile"
            ],
            "name": "ASTRA Analysis Profile",
            "version": "1.0.0"
        },
        {
            "@id": "#input/features",
            "@type": [
                "FormalParameter",
                "ASTRAInput"
            ],
            "description": "Transformed features",
            "inputFrom": "feature_extraction.features",
            "inputType": "data",
            "name": "features"
        },
        {
            "@id": "#output/predictions/recipe",
            "@type": [
                "CreateAction",
                "ASTRARecipe"
            ],
            "description": "python src/classify.py",
            "result": {
                "@id": "#output/predictions"
            }
        },
        {
            "@id": "#output/predictions",
            "@type": [
                "FormalParameter",
                "ASTRAOutput"
            ],
            "description": "Predicted class labels",
            "name": "predictions",
            "outputType": "data",
            "producer": {
                "@id": "#output/predictions/recipe"
            }
        },
        {
            "@id": "#output/accuracy/recipe",
            "@type": [
                "CreateAction",
                "ASTRARecipe"
            ],
            "description": "python src/evaluate.py",
            "object": [
                {
                    "@id": "#output/predictions"
                }
            ],
            "result": {
                "@id": "#output/accuracy"
            }
        },
        {
            "@id": "#output/accuracy",
            "@type": [
                "FormalParameter",
                "ASTRAOutput"
            ],
            "description": "Classification accuracy",
            "name": "accuracy",
            "outputType": "metric",
            "producer": {
                "@id": "#output/accuracy/recipe"
            }
        },
        {
            "@id": "#decision/split",
            "@type": [
                "DefinedTermSet",
                "ASTRADecision"
            ],
            "delegatesTo": {
                "@id": "../#decision/test_split"
            },
            "name": "split"
        },
        {
            "@id": "#decision/classifier/option/logistic",
            "@type": [
                "DefinedTerm",
                "ASTRAOption"
            ],
            "alternateName": "Logistic Regression",
            "name": "logistic"
        },
        {
            "@id": "#decision/classifier/option/svm",
            "@type": [
                "DefinedTerm",
                "ASTRAOption"
            ],
            "alternateName": "SVM (RBF)",
            "name": "svm"
        },
        {
            "@id": "#decision/classifier/option/knn",
            "@type": [
                "DefinedTerm",
                "ASTRAOption"
            ],
            "alternateName": "k-Nearest Neighbors",
            "name": "knn"
        },
        {
            "@id": "#decision/classifier",
            "@type": [
                "DefinedTermSet",
                "ASTRADecision"
            ],
            "alternateName": "Classifier",
            "defaultOption": {
                "@id": "#decision/classifier/option/logistic"
            },
            "hasOption": [
                {
                    "@id": "#decision/classifier/option/logistic"
                },
                {
                    "@id": "#decision/classifier/option/svm"
                },
                {
                    "@id": "#decision/classifier/option/knn"
                }
            ],
            "name": "classifier"
        }
